    {
      "story_id": "story_63afb5aa91d0",
      "title": "我不会在我的编码中使用法学硕士 / I will not be using LLMs in my coding",
      "url": "https://www.polso.info/why-i-will-not-be-using-llms-coding",
      "primary_url": "https://www.polso.info/why-i-will-not-be-using-llms-coding",
      "source": "Hacker News (黑客新闻)",
      "source_name": "Info Flow",
